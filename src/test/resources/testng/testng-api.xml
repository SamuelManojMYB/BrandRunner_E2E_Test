<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- BrandRunners Web API suite. Source of truth: "BrandRunners Web APIs" Postman collection.
     Covers "00. Auth & Session", "01. Control Settings", "02. ANP", "03. FWM",
     "04. Sales", "05. Master Data", "06. Files, Audit & Misc", and "07. Public,
     Maintenance & Cron" in full. Do not add other folders here until they go
     through the same analysis/verification process.
