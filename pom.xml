<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.metayb</groupId>
    <artifactId>end-to-end-testing</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <allure.version>2.27.0</allure.version>
        <allure.maven.version>2.11.2</allure.maven.version>
        <!-- Default suite for plain `mvn test` - unchanged from before. Override with
             -DsuiteXmlFile=src/test/resources/testng/testng-api.xml (or testng-mobile.xml's
             own -DexecutionTarget=... profile) to run a different suite independently. -->
        <suiteXmlFile>src/test/resources/testng/testng-api.xml</suiteXmlFile>
    </properties>

    <dependencies>
        <!-- Selenium -->
        <!-- https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-java -->
        <!-- Bumped from 4.35.0: io.appium:java-client 10.1.1 requires selenium-api/
             selenium-remote-driver/selenium-support >= 4.42.0 (verified against its
             published POM). 4.42.0 is the minimum that satisfies that floor. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.42.0</version>
        </dependency>

        <!-- Appium (mobile automation) -->
        <!-- https://mvnrepository.com/artifact/io.appium/java-client -->
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>10.1.1</version>
        </dependency>

        <!-- WebDriverManager -->
        <!-- https://mvnrepository.com/artifact/io.github.bonigarcia/webdrivermanager -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>6.3.4</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Apache POI -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- Cucumber -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.22.1</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>7.22.1</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>

        <!-- Allure -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>2.24.0</version>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-selenide</artifactId>
            <version>2.24.0</version>
        </dependency>

        <!-- Extent Reports -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>5.1.2</version>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.7</version>
        </dependency>

        <!-- Selenide -->
        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide</artifactId>
            <version>7.9.3</version>
        </dependency>

        <!-- REST Assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- JetBrains annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>16.0.2</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.20.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
        </dependency>

        <!-- CloudWatch Synthetics (Canary) -->
        <!-- https://repo1.maven.org/maven2/software/amazon/synthetics/aws-cloudwatch-synthetics-sdk-java/ -->
        <!-- Verified directly against Maven Central and the SDK's own source (aws/aws-cloudwatch-synthetics-sdk-java
             on GitHub) rather than AWS's own "Writing a canary" doc page, which shows a stale
             com.amazonaws.synthetics.Synthetics import - the real, current package is
             software.amazon.synthetics. 1.0.0 is the only version published. `provided` scope: this interface
             is supplied by the Synthetics Lambda execution environment at runtime, and must never be bundled
             into the canary deployment zip (see src/assembly/canary-zip.xml). -->
        <dependency>
            <groupId>software.amazon.synthetics</groupId>
            <artifactId>aws-cloudwatch-synthetics-sdk-java</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- AWS Systems Manager Parameter Store (Canary credentials) -->
        <!-- https://mvnrepository.com/artifact/software.amazon.awssdk/ssm -->
        <!-- Chosen over Secrets Manager: this Canary needs one static credential with no
             rotation, so Parameter Store (SecureString) is the simpler, cheaper fit. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssm</artifactId>
            <version>2.55.1</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Java Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire Plugin (TestNG only) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <systemPropertyVariables>
                        <allure.results.directory>target/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.1.2</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Allure Plugin -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <!-- Allure Report -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                </configuration>
            </plugin>

            <!-- Surefire Report -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!-- Mobile tests are opt-in only: default `mvn test` is untouched and
             keeps running testng-ui.xml. This profile activates automatically
             whenever -DexecutionTarget=... is passed (every mobile invocation
             sets it - emulator/physical/browserstack), so both of these work
             identically without requiring -Pmobile:
               mvn test -Dplatform=android -DexecutionTarget=emulator
               mvn test -Pmobile -Dplatform=android -DexecutionTarget=emulator -->
        <profile>
            <id>mobile</id>
            <activation>
                <property>
                    <name>executionTarget</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.1.2</version>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>src/test/resources/testng/testng-mobile.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <systemPropertyVariables>
                                <allure.results.directory>target/allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.1.2</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Canary packaging is opt-in only: default `mvn clean package`/`mvn clean test`
             are untouched. Activate with -Pcanary. ApiHealthCanary and friends are
             ordinary src/main/java classes already compiled by every build - this
             profile only adds a SEPARATE, filtered jar (classifier "canary") instead
             of reusing the normal project jar as-is. That matters: the normal jar
             packages the *entire* shared src/main/resources (every UI/mobile/API
             config file), which includes config/credentials.properties - a real
             plaintext password, committed for local dev use by the TestNG suite.
             Shipping that file inside the Canary artifact would violate "no
             credentials in the ZIP" outright, so this filtered jar excludes it (and
             other UI/mobile-only resources the Canary has no use for) explicitly,
             rather than relying on the normal jar and hoping nothing sensitive is in
             it. config/config.properties (base URL/tenant - not secret) is kept, since
             CanaryConfig's local-dev fallback path reads it via ConfigManager. -->
        <profile>
            <id>canary</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>canary-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>canary</classifier>
                                    <excludes>
                                        <exclude>config/credentials.properties</exclude>
                                        <exclude>config/input.properties</exclude>
                                        <exclude>config/mobile/**</exclude>
                                        <exclude>test-data/**</exclude>
                                        <exclude>log4j2.xml</exclude>
                                        <exclude>synthetics.json</exclude>
                                        <exclude>META-INF/services/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/canary-zip.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>canary</finalName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-canary-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>